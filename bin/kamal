#!/bin/bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    local services
    services=$(confit keys services 2>/dev/null | tr '\n' ' ')

    confit log "Kamal Deployment Tool"
    echo ""
    echo "Usage: $0 <service> <command> [options]"
    echo ""
    echo "Services: ${services:-none}"
    echo ""
    echo "Examples:"
    echo "  $0 my-app deploy"
    echo "  $0 my-app setup"
    exit 1
}

if [[ $# -lt 2 ]]; then
    usage
fi

if [ -z "${CONFIT_SSH:-}" ]; then
    exec confit ssh --key credentials.ssh.private_key -- "$0" "$@"
fi

SERVICE="$1"
shift

CONFIG_FILE="$PROJECT_ROOT/config/deploy/${SERVICE}.yml"

if [ ! -f "$CONFIG_FILE" ]; then
    confit log --err "No Kamal config found at $CONFIG_FILE"
    exit 1
fi

confit log "Running Kamal for $SERVICE"

kamal "$@" -c "$CONFIG_FILE"
