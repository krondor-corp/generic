#!/bin/bash
set -euo pipefail

usage() {
    confit log "Admin Tools"
    echo ""
    echo "Usage: $0 <command> [subcommand] [options]"
    echo ""
    echo "Commands:"
    echo "  db shell          Open psql shell to production"
    echo "  db pgadmin        Launch pgAdmin connected to production"
    echo "  db tunnel         Create SSH tunnel on localhost:5434"
    echo ""
    echo "Options:"
    echo "  --port <port>     Local port for tunnel/pgadmin (default: 5434)"
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

COMMAND="$1"
shift

# Ensure SSH agent is set up
if [ -z "${CONFIT_SSH:-}" ]; then
    exec confit ssh --key credentials.ssh.private_key -- "$0" "$COMMAND" "$@"
fi

SERVER_IP=$(confit --set stage=production resolve credentials.server.ip)

cleanup() {
    if [[ -n "${TUNNEL_PID:-}" ]]; then
        kill "$TUNNEL_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

start_tunnel() {
    local port="$1"
    local bind_addr="${2:-localhost}"

    if lsof -i ":$port" > /dev/null 2>&1; then
        confit log --err "Port $port is already in use"
        exit 1
    fi

    confit log "Starting SSH tunnel on ${bind_addr}:$port..."
    ssh -N -f \
        -L "${bind_addr}:${port}:localhost:5432" \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        -o ServerAliveInterval=60 \
        -o ExitOnForwardFailure=yes \
        "admin@$SERVER_IP"

    TUNNEL_PID=$(lsof -t -i ":$port" 2>/dev/null | head -1 || echo "")
    sleep 1

    if ! lsof -i ":$port" > /dev/null 2>&1; then
        confit log --err "Failed to establish SSH tunnel"
        exit 1
    fi
}

cmd_db() {
    local LOCAL_PORT="5434"
    local DB_NAME="postgres"
    local DB_USER="postgres"
    local DB_PASSWORD="postgres"

    if [[ $# -lt 1 ]]; then
        usage
    fi

    local SUBCOMMAND="$1"
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --port) LOCAL_PORT="$2"; shift 2 ;;
            *) confit log --err "Unknown option: $1"; exit 1 ;;
        esac
    done

    case "$SUBCOMMAND" in
        shell|psql)
            if ! command -v psql &>/dev/null; then
                confit log --err "psql is not installed (brew install postgresql)"
                exit 1
            fi

            start_tunnel "$LOCAL_PORT"
            confit log "Connected to production database via localhost:$LOCAL_PORT"

            PGPASSWORD="$DB_PASSWORD" psql \
                -h localhost -p "$LOCAL_PORT" \
                -U "$DB_USER" -d "$DB_NAME"
            ;;

        pgadmin)
            if ! command -v docker &>/dev/null; then
                confit log --err "Docker is not installed or not running"
                exit 1
            fi

            local PGADMIN_PORT="5050"
            local CONTAINER_NAME="$(confit resolve project.name)-pgadmin"

            if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
                docker stop "$CONTAINER_NAME" 2>/dev/null || true
                docker rm "$CONTAINER_NAME" 2>/dev/null || true
            fi

            local SERVERS_JSON=$(mktemp)
            cat > "$SERVERS_JSON" <<EOF
{
    "Servers": {
        "1": {
            "Name": "$(confit resolve project.name)-production",
            "Group": "Servers",
            "Host": "host.docker.internal",
            "Port": ${LOCAL_PORT},
            "MaintenanceDB": "${DB_NAME}",
            "Username": "${DB_USER}",
            "SSLMode": "prefer",
            "PassFile": "/pgpass"
        }
    }
}
EOF

            local PGPASS_FILE=$(mktemp)
            echo "host.docker.internal:${LOCAL_PORT}:${DB_NAME}:${DB_USER}:${DB_PASSWORD}" > "$PGPASS_FILE"
            chmod 600 "$PGPASS_FILE"

            docker run -d \
                --name "$CONTAINER_NAME" --rm \
                -p "${PGADMIN_PORT}:80" \
                -e "PGADMIN_DEFAULT_EMAIL=admin@localhost" \
                -e "PGADMIN_DEFAULT_PASSWORD=admin" \
                -e "PGADMIN_CONFIG_SERVER_MODE=False" \
                -e "PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False" \
                -v "${SERVERS_JSON}:/pgadmin4/servers.json:ro" \
                -v "${PGPASS_FILE}:/pgpass:ro" \
                dpage/pgadmin4:latest > /dev/null

            confit log --ok "pgAdmin started at http://localhost:$PGADMIN_PORT"
            echo ""
            echo "  URL:      http://localhost:$PGADMIN_PORT"
            echo "  Password: $DB_PASSWORD (when prompted for DB)"
            echo ""
            echo "Press Ctrl+C to stop tunnel (pgAdmin loses DB connection)"
            echo ""

            for i in {1..30}; do
                curl -s "http://localhost:$PGADMIN_PORT" > /dev/null 2>&1 && break
                sleep 1
            done
            open "http://localhost:$PGADMIN_PORT" 2>/dev/null || true

            ssh -N \
                -L "0.0.0.0:${LOCAL_PORT}:localhost:5432" \
                -o StrictHostKeyChecking=no \
                -o UserKnownHostsFile=/dev/null \
                -o LogLevel=ERROR \
                -o ServerAliveInterval=60 \
                "admin@$SERVER_IP"
            ;;

        tunnel)
            confit log "PostgreSQL tunnel: localhost:$LOCAL_PORT -> $SERVER_IP:5432"
            echo ""
            echo "  Host:     localhost"
            echo "  Port:     $LOCAL_PORT"
            echo "  Database: $DB_NAME"
            echo "  User:     $DB_USER"
            echo "  Password: $DB_PASSWORD"
            echo ""
            echo "Press Ctrl+C to close"

            ssh -N \
                -L "$LOCAL_PORT:localhost:5432" \
                -o StrictHostKeyChecking=no \
                -o UserKnownHostsFile=/dev/null \
                -o LogLevel=ERROR \
                -o ServerAliveInterval=60 \
                "admin@$SERVER_IP"
            ;;

        *)
            confit log --err "Unknown db subcommand: $SUBCOMMAND"
            usage
            ;;
    esac
}

case "$COMMAND" in
    db) cmd_db "$@" ;;
    *) confit log --err "Unknown command: $COMMAND"; usage ;;
esac
